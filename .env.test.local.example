# Copy to .env.test.local (gitignored) to run the cross-tenant isolation
# suite (npm run test:integration). Values come from the StabiFlow
# Supabase project's dashboard: Project Settings -> API.
#
# SUPABASE_SERVICE_ROLE_KEY is required here because the test suite
# creates and deletes real (temporary) auth users via the Admin API to
# prove RLS against genuine, independently-authenticated sessions - never
# run this against a project you don't own, and never commit this file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase C (Integrations) webhook/OAuth tests need these to match whatever
# was set via `supabase secrets set` for the edge functions - otherwise a
# signature the test computes will never match what the deployed function
# expects. Dev-only values, never real Meta credentials.
INTEGRATIONS_META_APP_SECRET=your-dev-only-shared-secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-dev-only-verify-token
